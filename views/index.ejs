<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>📝 My Blog</h1>
            <a href="/new" class="btn btn-primary">Write New Post</a>
        </div>
    </header>

    <main>
        <div class="container">
            <% if (posts.length === 0) { %>
                <div class="no-posts">
                    <p>No posts yet. <a href="/new">Create your first post!</a></p>
                </div>
            <% } else { %>
                <div class="posts-list">
                    <% posts.forEach(post => { %>
                        <article class="post-card">
                            <h2>
                                <a href="/post/<%= post.slug %>"><%= post.title %></a>
                            </h2>
                            <time><%= post.date.toLocaleDateString() %></time>
                        </article>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2026 My Blog. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
