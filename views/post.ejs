<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.slug %> - My Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>📝 My Blog</h1>
            <a href="/" class="btn btn-secondary">← Back to Posts</a>
        </div>
    </header>

    <main>
        <div class="container">
            <article class="post">
                <div class="post-content">
                    <%- post.content %>
                </div>
            </article>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2026 My Blog. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
